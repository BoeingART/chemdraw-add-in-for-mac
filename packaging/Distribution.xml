<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>ChemOffice for Mac 0.1.0</title>
    <welcome file="Welcome.html"/>
    <license file="LICENSE.txt"/>
    <conclusion file="Conclusion.html"/>
    <options customize="never" require-scripts="false" rootVolumeOnly="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <volume-check><allowed-os-versions><os-version min="12.0"/></allowed-os-versions></volume-check>
    <choices-outline><line choice="default"><line choice="com.chemoffice.mac.pkg"/></line></choices-outline>
    <choice id="default"/>
    <choice id="com.chemoffice.mac.pkg" visible="false"><pkg-ref id="com.chemoffice.mac.pkg"/></choice>
    <pkg-ref id="com.chemoffice.mac.pkg" version="0.1.0" onConclusion="none">ChemOffice-component.pkg</pkg-ref>
    <pkg-ref id="com.chemoffice.mac.pkg"><must-close><app id="com.chemoffice.mac"/></must-close></pkg-ref>
</installer-gui-script>
