<?xml version="1.0" ?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="TaskPaneApp">
  

  <Id>1079b757-4a92-4997-9e74-514af3e78e2a</Id>
  <Version>1.5.3.0</Version>
  <ProviderName>ChemDraw Add-in for Mac</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="ChemDraw Add-in for Mac"/>
  <Description DefaultValue="Edit source-carrying vector chemistry with your installed ChemDraw."><Override Locale="zh-CN" Value="使用已安装的ChemDraw编辑带有源数据的矢量化学结构。"/><Override Locale="zh-TW" Value="使用已安装的ChemDraw编辑带有源数据的矢量化学结构。"/><Override Locale="zh-HK" Value="使用已安装的ChemDraw编辑带有源数据的矢量化学结构。"/><Override Locale="zh-SG" Value="使用已安装的ChemDraw编辑带有源数据的矢量化学结构。"/></Description>
  <IconUrl DefaultValue="https://localhost:17524/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:17524/icon-80.png"/>
  <SupportUrl DefaultValue="https://localhost:17524/help"/>
  <AppDomains>
    <AppDomain>https://localhost:17524</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document"/>
    <Host Name="Presentation"/>
    <Host Name="Workbook"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:17524/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="ChemOffice.Tab">
              <Group id="ChemOffice.Drawing">
                <Label resid="GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Icon16"/>
                  <bt:Image size="32" resid="Icon32"/>
                  <bt:Image size="80" resid="Icon80"/>
                </Icon>
                <Control xsi:type="Button" id="ChemOffice.Open">
                  <Label resid="ButtonLabel"/>
                  <Supertip>
                    <Title resid="ButtonLabel"/>
                    <Description resid="ButtonHelp"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16"/>
                    <bt:Image size="32" resid="Icon32"/>
                    <bt:Image size="80" resid="Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ChemOffice.Panel</TaskpaneId>
                    <SourceLocation resid="PanelUrl"/>
                  </Action>
                </Control>
              </Group>
              <Label resid="TabLabel"/>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="ChemOffice.Tab">
              <Group id="ChemOffice.Drawing">
                <Label resid="GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Icon16"/>
                  <bt:Image size="32" resid="Icon32"/>
                  <bt:Image size="80" resid="Icon80"/>
                </Icon>
                <Control xsi:type="Button" id="ChemOffice.Open">
                  <Label resid="ButtonLabel"/>
                  <Supertip>
                    <Title resid="ButtonLabel"/>
                    <Description resid="ButtonHelp"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16"/>
                    <bt:Image size="32" resid="Icon32"/>
                    <bt:Image size="80" resid="Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ChemOffice.Panel</TaskpaneId>
                    <SourceLocation resid="PanelUrl"/>
                  </Action>
                </Control>
              </Group>
              <Label resid="TabLabel"/>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="ChemOffice.Tab">
              <Group id="ChemOffice.Drawing">
                <Label resid="GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Icon16"/>
                  <bt:Image size="32" resid="Icon32"/>
                  <bt:Image size="80" resid="Icon80"/>
                </Icon>
                <Control xsi:type="Button" id="ChemOffice.Open">
                  <Label resid="ButtonLabel"/>
                  <Supertip>
                    <Title resid="ButtonLabel"/>
                    <Description resid="ButtonHelp"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16"/>
                    <bt:Image size="32" resid="Icon32"/>
                    <bt:Image size="80" resid="Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ChemOffice.Panel</TaskpaneId>
                    <SourceLocation resid="PanelUrl"/>
                  </Action>
                </Control>
              </Group>
              <Label resid="TabLabel"/>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://localhost:17524/icon-16.png"/>
        <bt:Image id="Icon32" DefaultValue="https://localhost:17524/icon-32.png"/>
        <bt:Image id="Icon80" DefaultValue="https://localhost:17524/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="PanelUrl" DefaultValue="https://localhost:17524/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="TabLabel" DefaultValue="ChemDraw Add-in for Mac"/>
        <bt:String id="GroupLabel" DefaultValue="ChemDraw drawings"><bt:Override Locale="zh-CN" Value="ChemDraw绘图"/><bt:Override Locale="zh-TW" Value="ChemDraw绘图"/><bt:Override Locale="zh-HK" Value="ChemDraw绘图"/><bt:Override Locale="zh-SG" Value="ChemDraw绘图"/></bt:String>
        <bt:String id="ButtonLabel" DefaultValue="Open ChemDraw Add-in for Mac"><bt:Override Locale="zh-CN" Value="打开ChemDraw Add-in for Mac"/><bt:Override Locale="zh-TW" Value="打开ChemDraw Add-in for Mac"/><bt:Override Locale="zh-HK" Value="打开ChemDraw Add-in for Mac"/><bt:Override Locale="zh-SG" Value="打开ChemDraw Add-in for Mac"/></bt:String>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ButtonHelp" DefaultValue="Open the ChemDraw Add-in for Mac panel to edit the selected drawing, check connection status, and view instructions."><bt:Override Locale="zh-CN" Value="打开ChemDraw Add-in for Mac面板，编辑所选绘图、检查连接状态及查看使用说明。"/><bt:Override Locale="zh-TW" Value="打开ChemDraw Add-in for Mac面板，编辑所选绘图、检查连接状态及查看使用说明。"/><bt:Override Locale="zh-HK" Value="打开ChemDraw Add-in for Mac面板，编辑所选绘图、检查连接状态及查看使用说明。"/><bt:Override Locale="zh-SG" Value="打开ChemDraw Add-in for Mac面板，编辑所选绘图、检查连接状态及查看使用说明。"/></bt:String>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
  

</OfficeApp>
